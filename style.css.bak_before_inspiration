:root{
  --cyan:#29C2E7;
  --cyan-dark:#189ab9;
  --cyan-soft:#e6f9fd;
  --ink:#050808;
  --text:#2b3438;
  --muted:#5b676c;
  --bg:#ffffff;
  --tint:#f4fafd;
  --card-bg:#ffffff;
  --card-border:#e2edf1;
  --card-shadow:0 8px 30px rgba(5,8,8,0.05);
  --btn-bg:#050808;
  --btn-fg:#ffffff;
  --btn-hover:#1c2a2e;
  --panel:transparent;
  --whatsapp:#25D366;
  --whatsapp-hover:#1ebc59;
  --sharepoint:#0078d4;
  --sharepoint-hover:#106ebe;
  color-scheme:light;
}

:root[data-theme="dark"]{
  --ink:#ffffff;
  --text:#d3dcdf;
  --muted:#94a3a8;
  --bg:#0b1316;
  --tint:#111c20;
  --card-bg:#121e23;
  --card-border:#1f333a;
  --card-shadow:0 8px 30px rgba(0,0,0,0.4);
  --btn-bg:#29C2E7;
  --btn-fg:#050808;
  --btn-hover:#5cd3ef;
  --panel:#e8f8fc;
  color-scheme:dark;
}

@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --ink:#ffffff;
    --text:#d3dcdf;
    --muted:#94a3a8;
    --bg:#0b1316;
    --tint:#111c20;
    --card-bg:#121e23;
    --card-border:#1f333a;
    --card-shadow:0 8px 30px rgba(0,0,0,0.4);
    --btn-bg:#29C2E7;
    --btn-fg:#050808;
    --btn-hover:#5cd3ef;
    --panel:#e8f8fc;
    color-scheme:dark;
  }
}

*{margin:0;padding:0;box-sizing:border-box}
html{height:100%;scroll-behavior:smooth}
body{
  min-height:100%;
  transition:background-color .2s,color .2s;
  display:flex;
  flex-direction:column;
  font-family:"Barlow",system-ui,-apple-system,"Segoe UI",Arial,sans-serif;
  font-size:1.0625rem;
  line-height:1.6;
  color:var(--text);
  background:var(--bg);
}

/* Header & Top Bar */
.top{
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:1.5rem;
  padding:1.5rem clamp(1.25rem,5vw,4rem);
  border-bottom:1px solid var(--card-border);
  position:sticky;
  top:0;
  background:var(--bg);
  z-index:100;
  backdrop-filter:blur(8px);
}
.logo{display:block;width:clamp(160px,22vw,260px);height:auto}
.nav-group{display:flex;align-items:center;gap:1.25rem}
.nav-menu{display:flex;align-items:center;gap:1.5rem;list-style:none}
.nav-link{
  color:var(--text);
  font-weight:500;
  text-decoration:none;
  font-size:.95rem;
  transition:color .15s;
}
.nav-link:hover{color:var(--cyan)}
.nav-link.highlight{
  color:var(--sharepoint);
  font-weight:600;
  background:var(--tint);
  padding:.35rem .75rem;
  border-radius:999px;
  border:1px solid var(--card-border);
}

@media (max-width:768px){
  .nav-menu{display:none}
}

/* Hero Section */
.hero{
  display:grid;
  grid-template-columns:1fr;
  gap:2.5rem;
  align-items:center;
  max-width:1180px;
  width:100%;
  margin:0 auto;
  padding:2.5rem clamp(1.25rem,5vw,4rem) 3.5rem;
}
.copy{max-width:36rem}
.status{
  display:inline-flex;
  align-items:center;
  gap:.6rem;
  font-weight:600;
  font-size:.9rem;
  color:var(--cyan);
  background:var(--tint);
  padding:.4rem .9rem;
  border-radius:999px;
  margin-bottom:1.25rem;
  border:1px solid var(--card-border);
}
.dot{
  width:.65rem;
  height:.65rem;
  border-radius:50%;
  background:var(--cyan);
  animation:pulse 1.6s ease-in-out infinite;
}
h1{
  font-family:"Barlow Condensed","Arial Narrow",Arial,sans-serif;
  font-weight:700;
  font-size:clamp(2.5rem,7vw,4.5rem);
  line-height:1.05;
  letter-spacing:.005em;
  color:var(--ink);
  margin-bottom:1.25rem;
}
.lead{
  font-size:1.18rem;
  max-width:32rem;
  color:var(--muted);
  line-height:1.6;
}
.contact{
  margin-top:2rem;
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:1rem 1.25rem;
}
.btn{
  display:inline-flex;
  align-items:center;
  gap:.6rem;
  background:var(--btn-bg);
  color:var(--btn-fg);
  font-weight:600;
  text-decoration:none;
  padding:.85rem 1.4rem;
  border-radius:.6rem;
  border-bottom:4px solid var(--cyan);
  transition:all .15s ease-in-out;
}
.btn:hover{
  background:var(--btn-hover);
  transform:translateY(-2px);
}
.btn-whatsapp{
  background:var(--whatsapp);
  color:#ffffff;
  border-bottom-color:#1b9e4b;
}
.btn-whatsapp:hover{
  background:var(--whatsapp-hover);
}
.tel{
  color:var(--ink);
  font-weight:600;
  text-decoration:none;
  display:inline-flex;
  align-items:center;
  gap:.4rem;
  border-bottom:3px solid var(--cyan);
  transition:color .15s;
}
.tel:hover{color:var(--cyan)}
.btn:focus-visible,.tel:focus-visible{outline:3px solid var(--ink);outline-offset:3px}

.art{
  background:var(--panel);
  border-radius:1rem;
  padding:clamp(.5rem,2vw,1.5rem);
}
.art svg{
  display:block;
  width:100%;
  max-width:520px;
  height:auto;
  margin:0 auto;
}

@media (min-width:860px){
  .hero{grid-template-columns:1.05fr .95fr}
}

/* Sections Global */
.section{
  padding:4rem clamp(1.25rem,5vw,4rem);
  border-top:1px solid var(--card-border);
}
.section-alt{
  background:var(--tint);
}
.section-container{
  max-width:1180px;
  width:100%;
  margin:0 auto;
}
.section-header{
  margin-bottom:2.5rem;
}
.section-tag{
  display:inline-block;
  color:var(--cyan);
  font-weight:700;
  text-transform:uppercase;
  letter-spacing:.08em;
  font-size:.85rem;
  margin-bottom:.5rem;
}
.section-title{
  font-family:"Barlow Condensed","Arial Narrow",Arial,sans-serif;
  font-size:clamp(2.2rem,5vw,3.2rem);
  font-weight:700;
  color:var(--ink);
  line-height:1.15;
}
.section-subtitle{
  font-size:1.1rem;
  color:var(--muted);
  max-width:600px;
  margin-top:.6rem;
}

/* Services Grid */
.services-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(300px,1fr));
  gap:1.75rem;
}
.service-card{
  background:var(--card-bg);
  border:1px solid var(--card-border);
  border-radius:1rem;
  padding:2rem;
  display:flex;
  flex-direction:column;
  box-shadow:var(--card-shadow);
  transition:transform .2s ease,border-color .2s ease,box-shadow .2s ease;
  position:relative;
  overflow:hidden;
}
.service-card:hover{
  transform:translateY(-5px);
  border-color:var(--cyan);
  box-shadow:0 12px 35px rgba(41,194,231,0.15);
}
.service-icon-box{
  width:52px;
  height:52px;
  border-radius:12px;
  background:var(--tint);
  border:1px solid var(--card-border);
  display:flex;
  align-items:center;
  justify-content:center;
  color:var(--cyan);
  margin-bottom:1.25rem;
}
.service-title{
  font-family:"Barlow Condensed","Arial Narrow",Arial,sans-serif;
  font-size:1.6rem;
  font-weight:700;
  color:var(--ink);
  margin-bottom:.65rem;
}
.service-desc{
  font-size:1rem;
  color:var(--muted);
  line-height:1.55;
  margin-bottom:1.25rem;
  flex:1;
}
.service-tags{
  display:flex;
  flex-wrap:wrap;
  gap:.4rem;
  margin-top:auto;
}
.service-tag{
  background:var(--tint);
  color:var(--text);
  font-size:.8rem;
  font-weight:500;
  padding:.25rem .6rem;
  border-radius:.4rem;
  border:1px solid var(--card-border);
}

/* Trust / Avantages Grid */
.trust-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(240px,1fr));
  gap:1.5rem;
}
.trust-card{
  background:var(--card-bg);
  border:1px solid var(--card-border);
  border-radius:.85rem;
  padding:1.5rem;
  box-shadow:var(--card-shadow);
}
.trust-icon{
  font-size:1.8rem;
  margin-bottom:.75rem;
}
.trust-card h3{
  font-size:1.25rem;
  font-weight:700;
  color:var(--ink);
  margin-bottom:.4rem;
  font-family:"Barlow Condensed",sans-serif;
}
.trust-card p{
  font-size:.95rem;
  color:var(--muted);
}

/* Espace  / Formations */
.-container{
  background:var(--card-bg);
  border:2px solid var(--sharepoint);
  border-radius:1.25rem;
  padding:2.5rem clamp(1.25rem,4vw,3rem);
  box-shadow:var(--card-shadow);
  position:relative;
}
.-badge{
  display:inline-block;
  background:#0078d4;
  color:#ffffff;
  font-size:.85rem;
  font-weight:700;
  padding:.35rem .85rem;
  border-radius:999px;
  text-transform:uppercase;
  letter-spacing:.05em;
  margin-bottom:1rem;
}
.-header-title{
  font-family:"Barlow Condensed","Arial Narrow",Arial,sans-serif;
  font-size:clamp(1.8rem,4vw,2.5rem);
  font-weight:700;
  color:var(--ink);
  margin-bottom:.5rem;
}
.-instructor{
  display:inline-flex;
  align-items:center;
  gap:.6rem;
  font-size:1.05rem;
  font-weight:600;
  color:var(--sharepoint);
  margin-bottom:1.5rem;
}
.-grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
  gap:1.5rem;
  margin-top:1.5rem;
}
.-card{
  background:var(--tint);
  border:1px solid var(--card-border);
  border-radius:.85rem;
  padding:1.5rem;
  display:flex;
  flex-direction:column;
  justify-content:space-between;
}
.-card h4{
  font-size:1.35rem;
  color:var(--ink);
  font-family:"Barlow Condensed",sans-serif;
  font-weight:700;
  margin-bottom:.4rem;
}
.-card p{
  font-size:.92rem;
  color:var(--muted);
  margin-bottom:1.25rem;
  flex:1;
}
.-actions{
  display:flex;
  flex-direction:column;
  gap:.6rem;
}
.btn-sharepoint{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:.5rem;
  background:var(--sharepoint);
  color:#ffffff;
  text-decoration:none;
  font-weight:600;
  font-size:.9rem;
  padding:.65rem 1rem;
  border-radius:.5rem;
  transition:background .15s,transform .15s;
}
.btn-sharepoint:hover{
  background:var(--sharepoint-hover);
  transform:translateY(-1px);
}
.btn-course-online{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:.5rem;
  background:transparent;
  color:var(--ink);
  border:1.5px solid var(--cyan);
  text-decoration:none;
  font-weight:600;
  font-size:.88rem;
  padding:.55rem 1rem;
  border-radius:.5rem;
  transition:all .15s;
}
.btn-course-online:hover{
  background:var(--cyan);
  color:#050808;
}

/* Floating WhatsApp Button */
.floating-whatsapp{
  position:fixed;
  bottom:1.75rem;
  right:1.75rem;
  z-index:999;
  display:inline-flex;
  align-items:center;
  gap:.65rem;
  background:#25D366;
  color:#ffffff;
  text-decoration:none;
  padding:.75rem 1.25rem;
  border-radius:999px;
  box-shadow:0 6px 25px rgba(37,211,102,0.45);
  font-weight:700;
  font-size:.95rem;
  transition:transform .2s ease,box-shadow .2s ease;
}
.floating-whatsapp:hover{
  transform:scale(1.06);
  box-shadow:0 10px 30px rgba(37,211,102,0.65);
}
.floating-whatsapp svg{
  width:24px;
  height:24px;
  fill:currentColor;
  flex-shrink:0;
}
@media (max-width:540px){
  .floating-whatsapp span{display:none}
  .floating-whatsapp{padding:.85rem;border-radius:50%}
}

/* Footer */
.site-footer{
  border-top:4px solid var(--cyan);
  background:var(--tint);
  padding:3rem clamp(1.25rem,5vw,4rem) 2rem;
  color:var(--muted);
  font-size:.95rem;
}
.footer-inner{
  max-width:1180px;
  margin:0 auto;
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
  gap:2.5rem;
  margin-bottom:2.5rem;
}
.footer-col h4{
  color:var(--ink);
  font-family:"Barlow Condensed",sans-serif;
  font-size:1.3rem;
  margin-bottom:1rem;
}
.footer-col ul{
  list-style:none;
  display:flex;
  flex-direction:column;
  gap:.5rem;
}
.footer-col a{
  color:var(--muted);
  text-decoration:none;
  transition:color .15s;
}
.footer-col a:hover{color:var(--cyan)}
.footer-bottom{
  max-width:1180px;
  margin:0 auto;
  padding-top:1.5rem;
  border-top:1px solid var(--card-border);
  display:flex;
  justify-content:space-between;
  align-items:center;
  flex-wrap:wrap;
  gap:1rem;
}

/* Animations de l'illustration (conservées) */
#clock{animation:clockHand 5s infinite linear;transform-box:fill-box;transform-origin:bottom}
#leftTree,#righTree{animation:tree 2s ease-in-out infinite alternate;transform-box:fill-box;transform-origin:bottom}
#man{animation:manBody 1s ease-in-out infinite alternate;transform-box:fill-box;transform-origin:bottom}
#pc-circle{fill:var(--cyan);stroke-width:4;animation:light 3s linear infinite alternate}
@keyframes clockHand{from{transform:rotateZ(0)}to{transform:rotateZ(-360deg)}}
@keyframes manBody{from{transform:rotateX(0)}to{transform:rotateX(10deg)}}
@keyframes tree{from{transform:rotateZ(10deg)}to{transform:rotateZ(-20deg)}}
@keyframes light{0%{stroke:#050808}100%{stroke:#29C2E7}}
@keyframes pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.35;transform:scale(.7)}}
@media (prefers-reduced-motion:reduce){#clock,#leftTree,#righTree,#man,#pc-circle,.dot{animation:none}}

/* Bouton mode sombre */
.theme{
  display:inline-flex;
  align-items:center;
  gap:.5rem;
  font:500 .95rem/1 "Barlow",system-ui,sans-serif;
  color:var(--ink);
  background:transparent;
  border:2px solid var(--cyan);
  border-radius:999px;
  padding:.55rem .95rem;
  cursor:pointer;
  flex-shrink:0;
}
.theme:hover{background:var(--cyan);color:#050808}
.theme:focus-visible{outline:3px solid var(--ink);outline-offset:3px}
.i-sun{display:none}
.logo-dark{display:none}
:root[data-theme="dark"] .logo-light{display:none}
:root[data-theme="dark"] .logo-dark{display:block}
:root[data-theme="dark"] .i-moon{display:none}
:root[data-theme="dark"] .i-sun{display:block}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]) .logo-light{display:none}
  :root:not([data-theme="light"]) .logo-dark{display:block}
  :root:not([data-theme="light"]) .i-moon{display:none}
  :root:not([data-theme="light"]) .i-sun{display:block}
}
@media (max-width:420px){
  .theme-label{display:none}
  .theme{padding:.6rem}
}

/* Language Switcher */
.lang-switch{
  display:inline-flex;
  align-items:center;
  gap:.35rem;
  font-weight:700;
  font-size:.85rem;
  padding:.35rem .75rem;
  border-radius:999px;
  background:var(--tint);
  border:1px solid var(--card-border);
}
.lang-item{
  color:var(--muted);
  text-decoration:none;
  transition:color .15s;
}
.lang-item:hover{
  color:var(--cyan);
}
.lang-item.active{
  color:var(--cyan);
  font-weight:800;
}
.lang-sep{
  color:var(--muted);
  opacity:.5;
}

/* About Us Section Styles */
.about-highlight-box {
  background: var(--tint);
  border-left: 4px solid var(--cyan);
  padding: 1.25rem 1.5rem;
  border-radius: 0 .75rem .75rem 0;
  margin: 1.25rem 0 1.5rem;
  border-top: 1px solid var(--card-border);
  border-right: 1px solid var(--card-border);
  border-bottom: 1px solid var(--card-border);
}
.about-main-text {
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.6;
}
.about-sub-text {
  font-size: 1.05rem;
  color: var(--muted);
  line-height: 1.65;
  margin-bottom: 1.5rem;
  max-width: 850px;
}
.about-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 2.5rem;
  margin-top: 1.5rem;
  padding-top: 1.5rem;
  border-top: 1px solid var(--card-border);
}
.stat-item {
  display: flex;
  flex-direction: column;
}
.stat-number {
  font-family: "Barlow Condensed", sans-serif;
  font-size: 2.6rem;
  font-weight: 700;
  color: var(--cyan);
  line-height: 1;
}
.stat-label {
  font-size: .92rem;
  font-weight: 500;
  color: var(--muted);
  margin-top: .4rem;
}
